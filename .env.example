# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Keys: Supabase dashboard > Project Settings > API Keys.

# Browser values. Anything starting with VITE_ reaches the browser, so only the public (publishable) key goes here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-only values, used by the invite, outbox and export server functions. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email through Resend (decision 5d). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
OUTBOX_FROM_EMAIL=

# Scheduled sender (GET /api/cron/outbox, every 5 minutes on Vercel). Switched off while empty. Server-only.
CRON_SECRET=

# AI helpers (owner's morning brief). Off for every hotel until a System Administrator or General Manager switches it on in Admin.
# The key stays on the server. ANTHROPIC_API_URL and AI_MODEL are optional.
ANTHROPIC_API_KEY=

# Online subscription payments through Paystack (PLT-012). Server-only. Payments stay switched off while empty.
# Use the TEST secret key (sk_test_...) until Paystack has approved the live account.
# Webhook address to set in the Paystack dashboard: https://YOUR-DOMAIN/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
